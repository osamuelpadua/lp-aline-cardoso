{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/bio",
      "destination": "/links"
    },
    {
      "source": "/bio/",
      "destination": "/links"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lp-aline-cardoso.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
